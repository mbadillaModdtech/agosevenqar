// app/approvals/pending/page.tsx
import React, { useEffect, useState } from 'react';
import { apiFetch } from '@/lib/api-client';

const PendingApprovalsPage = () => {
  const [approvals, setApprovals] = useState([]);

  useEffect(() => {
    const loadApprovals = async () => {
      const response = await apiFetch('/api/approvals/pending');
      setApprovals(response.data);
    };

    loadApprovals();
  }, []);

  const handleApprove = async (id) => {
    await apiFetch(`/api/purchase-orders/${id}/approve`, { method: 'PUT' });
  };

  const handleReject = async (id) => {
    await apiFetch(`/api/purchase-orders/${id}/reject`, { method: 'PUT' });
  };

  const handleReevaluate = async (id) => {
    await apiFetch(`/api/purchase-orders/${id}/reevaluate`, { method: 'PUT' });
  };

  return (
    <div>
      {/* display pending approvals here */}
      <button onClick={() => handleApprove(approval.id)}>Approve</button>
      <button onClick={() => handleReject(approval.id)}>Reject</button>
      <button onClick={() => handleReevaluate(approval.id)}>Reevaluate</button>
    </div>
  );
};

export default PendingApprovalsPage;
